# Copy this file to source/.env.local (same folder) and fill in the values yourself.
# .env.local is git-ignored. Never paste the key into chat, code, or a VITE_ variable.

# Gemini API key from a Google AI Studio project on the FREE tier (no billing attached).
GEMINI_API_KEY=

# A free-tier text model your project can use (check AI Studio → Rate limits). e.g. gemini-2.5-flash
GEMINI_MODEL=

# Optional locally; REQUIRED on hosted previews: invite code testers type once in the app.
SOPHIE_INVITE_CODE=

# Optional: per-instance daily request cap (default 150). The real ceiling is the free-tier quota.
SOPHIE_DAILY_LIMIT=
